# ─────────────────────────────────────────────────────────────
#  NextTravelAI — configurare medii externe (opțional)
# ─────────────────────────────────────────────────────────────
# Copiază acest fișier în „.env" și completează cheile pe care le ai.
# Aplicația funcționează COMPLET și fără nicio cheie, în modul demo.
# Când o cheie este prezentă, stratul de servicii comută automat
# de la datele demonstrative la API-ul real.
#
#   cp .env.example .env
#
# ATENȚIE: fișierul „.env" este ignorat de git — nu îți expune cheia.

# --- Agent AI (ex. Claude API / OpenAI etc.) ---
# Providerul: "anthropic" | "openai" | "demo" (implicit demo)
VITE_AI_PROVIDER=demo
VITE_AI_API_KEY=
VITE_AI_MODEL=claude-sonnet-5

# --- Zboruri (ex. Amadeus, Skyscanner) ---
VITE_FLIGHTS_API_KEY=

# --- Hoteluri (ex. Booking, Hotels API) ---
VITE_HOTELS_API_KEY=

# --- Vreme (ex. OpenWeather) ---
VITE_WEATHER_API_KEY=

# --- Hărți (Google Maps sau alternativă) ---
VITE_MAPS_API_KEY=

# --- Autentificare Google (Sign in with Google) ---
# Obține un Client ID gratuit din Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
#   → Create Credentials → OAuth client ID → Web application
#   → adaugă domeniul tău la „Authorized JavaScript origins"
# Fără această valoare, autentificarea rulează în mod demo.
VITE_GOOGLE_CLIENT_ID=
